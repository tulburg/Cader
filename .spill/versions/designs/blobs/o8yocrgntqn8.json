{"artboards":[{"id":"ab-1","title":"Saved, clean, with Export menu","variant":"","width":"1440px","height":"900px","created":"2026-11-13T18:52:58.555Z","status":"accepted","html":"<div data-node=\"ab-1\" style=\"width: 1440px; height: 900px; background: #f9f8f4; position: relative; overflow: hidden; font-family: -apple-system, system-ui, sans-serif; color: #1d1d1f\">\n<div data-node=\"n-3\" style=\"position:absolute;left:0;top:0;right:0;height:64px;display:flex;align-items:center;padding:0 28px 0 96px;font-size:13px\">\n  <div data-node=\"n-4\" style=\"font-family:'Snell Roundhand','Apple Chancery',cursive;font-size:38px;line-height:1;width:44px\">C</div>\n  <div data-node=\"n-5\" style=\"flex:1;display:flex;gap:10px;align-items:center;justify-content:center;color:#6e6e73\">Library <span data-node=\"n-6\" style=\"color:#a1a1a6\">/</span> <b data-node=\"n-7\" style=\"color:#1d1d1f;font-weight:500\">Remarks for the Riverside Library Opening</b> <span data-node=\"n-8\" style=\"font-size:11px;background:#ececea;border-radius:10px;padding:2px 8px\">Speech</span></div>\n  <div data-node=\"n-9\" style=\"display:flex;gap:14px;align-items:center\">\n    <span data-node=\"n-10\" style=\"padding:6px 12px;border-radius:8px;border:1px solid rgba(0,0,0,.12);background:#fff\">Request review</span>\n    <div data-node=\"n-11\" style=\"display:flex;border:1px solid rgba(0,0,0,.1);border-radius:8px;background:#fff;overflow:hidden\"><span data-node=\"n-12\" style=\"padding:6px 10px;color:#a1a1a6\">&#8249;</span><span data-node=\"n-13\" style=\"padding:6px 10px;border-left:1px solid rgba(0,0,0,.1);border-right:1px solid rgba(0,0,0,.1)\">v3 of 3</span><span data-node=\"n-14\" style=\"padding:6px 10px;color:#a1a1a6\">&#8250;</span></div>\n    <div data-node=\"n-15\" style=\"position:relative\"><span data-node=\"n-16\" style=\"padding:6px 12px;border-radius:8px;background:#1d1d1f;color:#fff\">Export &#9662;</span>\n      <div data-node=\"n-17\" style=\"position:absolute;right:0;top:36px;width:230px;background:#fff;border-radius:12px;box-shadow:0 1px 2px rgba(0,0,0,.06),0 8px 28px rgba(0,0,0,.1);padding:6px;font-size:13px\">\n        <div data-node=\"n-18\" style=\"padding:8px 10px;border-radius:8px;background:#f4f4f2\">Copy text<span data-node=\"n-19\" style=\"float:right;color:#a1a1a6\">&#8984;&#8679;C</span></div>\n        <div data-node=\"n-20\" style=\"padding:8px 10px\">Markdown (.md)</div>\n        <div data-node=\"n-21\" style=\"padding:8px 10px\">Plain text (.txt)</div>\n        <div data-node=\"n-22\" style=\"height:1px;background:rgba(0,0,0,.08);margin:4px 6px\"></div>\n        <div data-node=\"n-23\" style=\"padding:8px 10px\">Reading view<span data-node=\"n-24\" style=\"float:right;color:#a1a1a6\">&#8984;&#8679;R</span></div>\n        <div data-node=\"n-25\" style=\"padding:8px 10px\">PDF, one paragraph per block</div>\n        <div data-node=\"n-26\" style=\"padding:6px 10px 4px;font-size:11px;color:#a1a1a6\">Exports v3, the latest saved version</div>\n      </div>\n    </div>\n  </div>\n</div>\n<div data-node=\"n-27\" style=\"position:absolute;left:250px;top:110px;width:640px;font-family:Charter,Georgia,serif\">\n  <div data-node=\"n-28\" style=\"font-size:34px;line-height:42px;font-weight:700;margin-bottom:22px\">Remarks for the Riverside Library Opening</div>\n  <p data-node=\"n-29\" style=\"font-size:19px;line-height:31px;color:#2c2c2e;margin:0 0 18px\">Good evening, and thank you all for coming. When this building first opened its doors in 1962, the town was smaller, the river was cleaner, and the idea of a public library was vital to the families who lived here.</p>\n  <p data-node=\"n-30\" style=\"font-size:19px;line-height:31px;color:#2c2c2e;margin:0 0 18px\">Tonight we are not just reopening a building. We are keeping a promise made to every child who ever sat cross-legged on that carpet and found a world inside a book.</p>\n  <p data-node=\"n-31\" style=\"font-size:19px;line-height:31px;color:#2c2c2e;margin:0\">The people who have worked on this renovation gave more than their time. They gave their weekends, their patience, and in a few cases, their actual blood, sweat and tears when the old shelves came down.</p>\n</div>\n<div data-node=\"n-32\" style=\"position:absolute;right:28px;bottom:28px;font-size:12px;color:#a1a1a6\">Saved v3 &#183; Today, 9:40 am &#183; reviews completed</div>\n<div data-node=\"n-33\" style=\"position:absolute;left:250px;bottom:40px;width:640px;font-size:12px;color:#a1a1a6;line-height:18px\">Design note: after Save the text reads clean (no marks, no notes, no badge, no Proofread count). Save is replaced by Export. Request review starts a new pass on this text; editing or dictating also starts one.</div></div>\n","h":"yx77wwa8064d"},{"id":"ab-2","title":"Reading view (speech)","variant":"","width":"1440px","height":"900px","created":"2026-11-13T18:52:58.556Z","status":"accepted","html":"<div data-node=\"ab-2\" style=\"width: 1440px; height: 900px; background: #111113; position: relative; overflow: hidden; font-family: -apple-system, system-ui, sans-serif; color: #f2f2f0\">\n<div data-node=\"n-34\" style=\"position:absolute;left:0;top:0;right:0;height:56px;display:flex;align-items:center;justify-content:space-between;padding:0 28px 0 96px;font-size:13px;color:#8e8e93\">\n  <span data-node=\"n-35\">Remarks for the Riverside Library Opening &#183; v3</span>\n  <span data-node=\"n-36\" style=\"display:flex;gap:18px\"><span data-node=\"n-37\">A&#8722;</span><span data-node=\"n-38\">A+</span><span data-node=\"n-39\">Esc to close</span></span>\n</div>\n<div data-node=\"n-40\" style=\"position:absolute;left:220px;right:220px;top:150px;font-family:Charter,Georgia,serif;font-size:44px;line-height:66px\">\n  <p data-node=\"n-41\" style=\"margin:0 0 54px;color:#f2f2f0\">Tonight we are not just reopening a building. We are keeping a promise made to every child who ever sat cross-legged on that carpet and found a world inside a book.</p>\n  <p data-node=\"n-42\" style=\"margin:0;color:#6e6e73\">The people who have worked on this renovation gave more than their time. They gave their weekends, their patience, and in a few cases, their actual blood, sweat and tears.</p>\n</div>\n<div data-node=\"n-43\" style=\"position:absolute;left:0;right:0;bottom:30px;text-align:center;font-size:12px;color:#6e6e73\">2 of 4 &#183; Space or &#8595; for the next paragraph</div></div>\n","h":"xz234lsahw8g"}],"feedback":{"pins":[],"notes":[],"reviews":{"":{"status":"accepted","at":"2026-11-13T19:16:49.734Z"}}}}